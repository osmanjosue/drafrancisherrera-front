# Configuración del widget de chat (Vite expone solo variables con prefijo VITE_)
# Copia este archivo a .env.local y completa los valores reales.

# URL del nodo Webhook de n8n que recibe los mensajes del chat
VITE_CHAT_WEBHOOK_URL=https://n8n.tu-dominio.com/webhook/chat

# Token compartido que n8n valida en el header X-Webhook-Token
# Genera uno aleatorio, p.ej.: openssl rand -hex 24
VITE_CHAT_WEBHOOK_TOKEN=
