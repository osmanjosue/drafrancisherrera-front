# Configuración del widget de chat (Vite expone solo variables con prefijo VITE_)
# Copia este archivo a .env.local y completa los valores reales.

# URL del BACKEND propio (Express) que recibe los mensajes del chat.
# El backend valida CORS/rate-limit/anti-bot y reenvía a n8n con el secreto.
VITE_CHAT_WEBHOOK_URL=https://tu-backend/api/webhook_chatbot_drafrancisherrera

# (Obsoleto con el backend intermediario) Token que enviaba el navegador.
# Dejar vacío: la seguridad la maneja el backend, no un token del navegador.
VITE_CHAT_WEBHOOK_TOKEN=

# Site key PÚBLICA de Cloudflare Turnstile (anti-bot). OPCIONAL.
# Vacío = anti-bot desactivado. La clave SECRETA va en el backend.
# Obtener en: https://dash.cloudflare.com/ -> Turnstile
VITE_TURNSTILE_SITE_KEY=
